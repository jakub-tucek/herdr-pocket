    "@xterm/xterm": "5.5.0",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "24.10.0",
    "@types/ws": "8.18.1",
    "esbuild": "0.25.12",
    "playwright-core": "1.56.1",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
